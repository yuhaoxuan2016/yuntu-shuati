# 复制此文件为 .env 并按需填写（.env 已被 gitignore 排除，不会上传仓库）
# 默认云端环境 ID（腾讯云 CloudBase）：
# 填写后，未在设置页配置云同步的访客会自动连接该环境，只读浏览公共题库/公共考试。
# 留空 = 纯本地模式（无默认云端环境，用户需在设置页自行填写 envId）。
VITE_DEFAULT_CLOUD_ENV_ID=

# 腾讯云 AppID：当前代码中没有任何引用（历史注释所称的「用于拼出默认站点域名」
# 与「社交标签回退」均未实现，见下条 VITE_SITE_URL）。保留占位，填了不生效。
VITE_TENCENT_APPID=

# 站点正式域名（如 https://www.example.com）：og/twitter 分享标签注入用。
# 无回退：留空或不定义时，构建会移除 og:image / og:url / twitter:image 三条标签
# （相对 URL 与 %VITE_SITE_URL% 字面量都会破坏社交预览），标题/描述标签保留。
VITE_SITE_URL=

# ICP 备案号（如：X ICP备 00000000 号）：侧边栏底部展示用。
# 不配置则不显示备案链接。⚠️ 备案号关联个人身份，勿写入仓库。
VITE_ICP_NUMBER=
